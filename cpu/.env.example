# Select the dev or root Dockerfile branch. Dev always uses the account
# name dev with HOME=/workspace; only its numeric UID/GID are configurable.
USER_MODE=dev
USER_UID=1001
USER_GID=1001

# Base image and build-time tool versions.
PYTHON_VERSION=3.12-bookworm
NODE_VERSION=24-bookworm-slim
UV_VERSION=0.12.5

# Set true to include Docker CLI, or false to disable it. Empty or unset values
# also resolve to false. Only true adds the -docker suffix to the image tag.
INSTALL_DOCKER_CLI=
DOCKER_CLI_VERSION=28.5.1-cli

# Use CERNET mirrors for Debian, pip and uv plus npmmirror for npm. This must be
# exactly true or false.
IN_MAINLAND=true

# Network used by build steps. This does not enable or configure a proxy.
BUILD_NETWORK=default

# Optional reference values exposed only as back_* variables in the container.
# They are not forwarded as build arguments or active proxy environment variables.
http_proxy=
https_proxy=
no_proxy=localhost,127.0.0.1,::1


########### Runtime ###########

# Match the host socket GID for the initial container process (Linux: stat -c %g
# /var/run/docker.sock). The entrypoint also registers group membership for SSH.
DOCKER_GID=999

# SSH server is always enabled and accepts public-key authentication only. An
# nonempty SSH_PUBLIC_KEY overrides the copied authorized_keys.
SSH_BIND_IP=127.0.0.1
SSH_HOST_PORT=2222
SSH_PUBLIC_KEY=

# Read-only SSH source directory; must exist on the Docker host.
SSH_SOURCE_DIR=${HOME}/.ssh

# Native Linux binaries named codex and/or claude, matching container architecture.
# Create this directory even when no agent binaries are needed. Mounted read-only.
AGENT_BIN_DIR=./agent-bin

# These host directories must exist before `docker compose up` or `run`.
CLAUDE_DATA_DIR=./data/claude
CODEX_DATA_DIR=./data/codex
