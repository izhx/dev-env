# Keep the Python base image's root user by default. Set all four values when
# building for a host user; the group name remains the same as USER_NAME.
USER_NAME=zhang
USER_UID=1001
USER_GID=1001
USER_HOME=/home/zhang

# Base image and tool versions. Use exact Claude/Codex versions here for fully
# reproducible builds, or keep "latest" to resolve them during uncached builds.
PYTHON_VERSION=3.12-bookworm
NODE_VERSION=24-bookworm-slim
UV_VERSION=0.12.5
# Leave optional install flags empty to disable them; set them to true to
# enable them. Do not write false because Compose uses non-empty values when
# generating the image tag suffix.
INSTALL_DOCKER_CLI=
DOCKER_CLI_VERSION=28.2.2-cli
INSTALL_CLAUDE_CODE=
INSTALL_CODEX=
CLAUDE_CODE_VERSION=latest
CODEX_VERSION=latest

# The Claude/Codex directories below this host path must exist before
# `docker compose up` and must be writable by USER_UID:USER_GID.
# No credentials are stored in this file.
DEV_DATA_ROOT=/data/dev
