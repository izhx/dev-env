# Select the dev or root Dockerfile branch. Dev always uses the account
# name dev with HOME=/workspace; only its numeric UID/GID are configurable.
USER_MODE=dev
USER_UID=1001
USER_GID=1001

# Base image and tool versions. Use exact Claude/Codex versions for fully
# reproducible builds, or keep "latest" to resolve them during uncached builds.
PYTHON_VERSION=3.12-bookworm
NODE_VERSION=24-bookworm-slim
UV_VERSION=0.12.5
HERDR_VERSION=0.8.2

# Leave optional install flags empty to disable them; set them to true to
# enable them. Empty values resolve to false for Dockerfile build arguments and
# do not add an image-tag suffix.
INSTALL_DOCKER_CLI=
DOCKER_CLI_VERSION=28.5.1-cli
INSTALL_CLAUDE=
INSTALL_CODEX=
CLAUDE_VERSION=latest
CODEX_VERSION=latest

# Use CERNET mirrors for Debian, pip and uv plus npmmirror for npm. This must be
# exactly true or false.
IN_MAINLAND=false

# Keep "default" for a proxy reachable from Docker's bridge network. If the
# proxy only listens on this Linux host's 127.0.0.1, set this to "host" so image
# build steps can reach it.
BUILD_NETWORK=default

# Optional HTTP proxy used by image build steps and the running container.
http_proxy=
https_proxy=
no_proxy=localhost,127.0.0.1,::1


########### Runtime ###########

# SSH server is always enabled and accepts public-key authentication only. An
# empty SSH_PUBLIC_KEY is allowed but leaves no injected login key.
SSH_BIND_IP=127.0.0.1
SSH_HOST_PORT=2222
SSH_PUBLIC_KEY=

# These host directories must exist before `docker compose up` or `run`.
CLAUDE_DATA_DIR=./data/claude
CODEX_DATA_DIR=./data/codex
