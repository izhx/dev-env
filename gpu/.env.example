# Reuse ubuntu with HOME=/home/ubuntu, or use root with HOME=/root.
# Match the host UID/GID in ubuntu mode; keep the existing account and home.
USER_MODE=ubuntu
USER_UID=1000
USER_GID=1000

CUDA_IMAGE=nvidia/cuda:13.0.2-devel-ubuntu24.04
NODE_VERSION=24-bookworm-slim
UV_VERSION=0.12.5

# true adds the Docker CLI, Compose, Buildx, and host socket.
# false (or empty) omits them. GPU access does not require this switch.
INSTALL_DOCKER_CLI=false
DOCKER_CLI_VERSION=28.5.1-cli
# Supplementary group, including SSH sessions, even when Docker is disabled.
# Match the host Docker group: getent group docker
DOCKER_GID=999

# Ubuntu, pip, uv and npm mirrors. NVIDIA's apt repository stays unchanged.
IN_MAINLAND=true
BUILD_NETWORK=default
# Runtime host networking is independent of BUILD_NETWORK.
NETWORK_MODE=host

# Reference values only; these do not enable a proxy or reach SSH sessions.
http_proxy=
https_proxy=
no_proxy=localhost,127.0.0.1,::1

# all or a positive integer. For specific devices, replace count with device_ids
# in compose.yaml. This controls visibility, not exclusive GPU allocation.
GPU_COUNT=all
SHM_SIZE=8gb

# sshd binds this host address/port directly; there is no port mapping.
# Port 2223 lets the CPU environment continue to use its default port 2222.
SSH_BIND_IP=127.0.0.1
SSH_HOST_PORT=2223
SSH_PUBLIC_KEY=
SSH_SOURCE_DIR=${HOME}/.ssh

# Native Linux codex and/or claude binaries. The directory must already exist.
# Reuse the CPU binaries by setting AGENT_BIN_DIR=../cpu/agent-bin.
AGENT_BIN_DIR=./agent-bin

# Existing writable directories; ownership must match the selected user.
CLAUDE_DATA_DIR=./data/claude
CODEX_DATA_DIR=./data/codex

# Existing absolute project directory, mounted at the same path in the container.
WORKSPACE_DIR=/data8-2/zhangxin/teleai
